# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.

# --- Spotify OAuth ---
# Register / manage credentials at: https://developer.spotify.com/dashboard
# Steps to rotate credentials:
#   1. Open the app in the Spotify Developer Dashboard.
#   2. Click "Settings" → "Client secret" → "View client secret" → copy.
#   3. To rotate: click "Rotate secret" — the old secret becomes invalid immediately.
#   4. Update SPOTIFY_CLIENT_SECRET below (and in any deployment secrets store).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the URI registered in the Spotify Developer Dashboard.
# Development:  http://127.0.0.1:8000/api/auth/callback
# Production:   https://yourdomain.com/api/auth/callback   (HTTPS required)
# Add the production URI under: Dashboard → App → Settings → Redirect URIs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# --- JWT ---
# Generate a cryptographically-strong key before going to production:
#   python -c "import secrets; print(secrets.token_hex(64))"
# Minimum recommended length: 64 hex chars (256 bits).
# Rotate this key if it is ever compromised — all active sessions will be invalidated.
JWT_SECRET_KEY=

# --- Database (PostgreSQL in production) ---
POSTGRES_USER=blessedear
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be set — docker-compose.prod.yml has no default for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
POSTGRES_DB=blessedear
# Full connection URL consumed by the backend (built from the values above):
DATABASE_URL=postgresql://blessedear:CHANGE_ME@localhost:5432/blessedear

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- URLs ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:3000,http://127.0.0.1:3000
# Production:   https://blessedear.com,https://www.blessedear.com
# The backend startup guard will warn if this contains localhost when DEBUG=false.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Feature flags (production must be false) ---
DEBUG=false
LOG_LEVEL=INFO
